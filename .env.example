# Copie para .env, que o git ignora, e preencha o que for usar

# Com GPU NVIDIA e o NVIDIA Container Toolkit, descomente para o treino usar a GPU
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# A credencial da geração de KCs, uma das duas, o token da assinatura (claude setup-token) ou uma chave da API
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# O IP em que o app publica a porta 5173, e o padrão 127.0.0.1 deixa o app só nesta máquina
# EDMKT_BIND_IP=127.0.0.1

# Nomes de host aceitos pelo Vite além do localhost, separados por vírgula, para abrir o app por outro nome
# EDMKT_ALLOWED_HOSTS=
