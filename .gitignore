# Python bytecode (generated by test runs inside the container)
__pycache__/
*.py[cod]
.pytest_cache/

# Datasets provisionados no nitro (CSEDM do teste de regressão etc.) — grandes, nunca versionados (D-12)
datasets/
# Dados de turma do fluxo de ingestão (uploads, clean/, cache/, models/)
data/
# Banco SQLite do app (criado no boot pelo lifespan; runtime, nunca versionado)
app.db
app.db-shm
app.db-wal
# Exceção: fixtures de teste versionadas (pequenas, artefatos de referência do TCC 1 — NÃO são dados de
# turma nem o CSEDM grande do D-12). tests/data/ é raiz hermética dos testes.
!tests/data/
!tests/data/**

# Lixo de sistema e segredos locais
.DS_Store
.env
.env.*
*.egg-info/

# Skills de agente instaladas só nesta máquina (as do projeto ficam em .claude/skills/ versionadas)
.agents/
.cursor/
.windsurf/
.claude/skills/frontend-design/
.claude/skills/web-design-guidelines/

# Diagramas de trabalho do schema (ficam no diretório, fora do repositório)
gen_excalidraw.py
schema-edmkt.excalidraw
schema-edmkt.html
