# Python bytecode (generated by test runs inside the container)
__pycache__/
*.py[cod]
.pytest_cache/

# Datasets locais, como a CSEDM dos testes de regressão, grandes demais para versionar
datasets/
# Dados de turma do fluxo de ingestão (uploads, clean/, cache/, models/)
data/
# O banco SQLite do app, criado quando a api sobe
app.db
app.db-shm
app.db-wal
# Os dados pequenos dos testes ficam versionados, e não são dados de turma
!tests/data/
!tests/data/**

# Lixo de sistema e segredos locais
.DS_Store
.env
.env.*
!.env.example
*.egg-info/

# Configuração e instruções de agentes de código, locais de cada máquina
CLAUDE.md
.claude/
.agents/
.cursor/
.windsurf/

# Diagramas de trabalho do schema, fora do repositório
gen_excalidraw.py
schema-edmkt.excalidraw
schema-edmkt.html
