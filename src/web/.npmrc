# openapi-typescript@7.13.0 declares a stale `peer typescript@^5.x` range, but the project pins
# typescript@6.0.3 (locked stack). openapi-typescript only emits a plain .d.ts schema and does not
# touch the TS public API that changed in 6.x, so the peer range is an advisory we deliberately relax.
# Scoped here (not a global flag) so installs stay deterministic without --force on the CLI.
legacy-peer-deps=true
