.git
.claude
**/__pycache__
**/*.pyc
.pytest_cache
*.egg-info
# Large data blobs — fixtures are generated as code, not shipped.
tests/data/**/*.csv
tests/data/**/*.parquet
tests/data/**/*.pkl
# Frontend build artifacts — node_modules is baked into the image, dist is generated.
# Keeps a stray host node_modules out of the build context.
frontend/node_modules
frontend/dist
