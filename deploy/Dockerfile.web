# Dev/test/build toolchain image for the EDM·KT React SPA (src/web/).
# FIXED TAG (no `latest`) — pinned to the host Node (22.22.2) for parity, following the
# project's reproducibility-anchor discipline (see ./Dockerfile and deploy/Dockerfile.app).
# node_modules is BAKED into this image layer via `npm ci`, so it never lands on the host:
# docker-compose masks /app/src/web/node_modules with a named volume seeded from here, and
# the repo bind-mount only carries the (node_modules-free) source tree.
FROM node:22.22.2-bookworm-slim

WORKDIR /app/src/web

# Manifests first so the install layer caches across source edits. npm ci is deterministic
# against the committed lockfile and fails loudly if package.json and the lock disagree.
COPY src/web/package.json src/web/package-lock.json src/web/.npmrc ./
RUN npm ci

# Source is bind-mounted at run time (docker-compose); no source COPY here.
CMD ["npx", "vitest", "run"]
